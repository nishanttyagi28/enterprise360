# Copy to .env and fill in locally. .env is gitignored; never commit credentials.
# Read by ingestion (pydantic-settings), orchestration and dbt (the wrappers load .env before dbt).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise360
POSTGRES_USER=e360_app
POSTGRES_PASSWORD=change-me
# Optional: only for scripts/setup.ps1 -CreateDatabase (creating role + DB as a superuser).
POSTGRES_ADMIN_USER=postgres
# Disposable DB for pytest integration tests (fixtures are loaded into it). Never the main DB.
E360_TEST_DB=enterprise360_test
# Folder holding the 9 Olist CSVs (relative to repo root). Fixtures: tests/fixtures/olist
E360_OLIST_DIR=data/raw/olist
E360_LOG_LEVEL=INFO
E360_DBT_THREADS=4
