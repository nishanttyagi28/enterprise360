model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PgServer","PgDatabase","PgSchema","PgSchemaUci","PgSchemaUciMarts","PgSchemaMarts","Order Item","Order","Payment","Delivery","Customer","Geography","Seller","Product","Order Status","Date","DQ Results","DQ Run Summary","Lead","Closed Deal","Lead Origin","Funnel Time to Close","GMV Forecast","GMV Forecast Backtest","GMV Anomalies","UCI Invoice Line","UCI Invoice","UCI Date","UCI Customer","UCI Product","UCI Country","UCI Cohort","UCI RFM","_Measures","_Measures UCI"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Order Item'
ref table Order
ref table Payment
ref table Delivery
ref table Customer
ref table Geography
ref table Seller
ref table Product
ref table 'Order Status'
ref table Date
ref table 'DQ Results'
ref table 'DQ Run Summary'
ref table Lead
ref table 'Closed Deal'
ref table 'Lead Origin'
ref table 'Funnel Time to Close'
ref table 'GMV Forecast'
ref table 'GMV Forecast Backtest'
ref table 'GMV Anomalies'
ref table 'UCI Invoice Line'
ref table 'UCI Invoice'
ref table 'UCI Date'
ref table 'UCI Customer'
ref table 'UCI Product'
ref table 'UCI Country'
ref table 'UCI Cohort'
ref table 'UCI RFM'
ref table _Measures
ref table '_Measures UCI'
ref table 'Time Intelligence'

ref role 'State Manager (demo)'

ref cultureInfo en-US
