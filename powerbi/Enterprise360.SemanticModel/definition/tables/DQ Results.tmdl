	partition 'DQ Results' = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Data = try Source{[Schema = PgSchema, Item = "dq_results"]}[Data] otherwise #table(type table [run_id = any, run_at = any, check_id = any, check_name = any, layer = any, model_name = any, kpi_id = any, severity = any, weight = any, status = any, failing_rows = any, source_value = any, mart_value = any, variance = any], {}),
					Selected = Table.SelectColumns(Data, {"run_id", "run_at", "check_id", "check_name", "layer", "model_name", "kpi_id", "severity", "weight", "status", "failing_rows", "source_value", "mart_value", "variance"}),
					Typed = Table.TransformColumnTypes(Selected, {{"run_id", type text}, {"check_id", type text}, {"run_at", type datetime}, {"weight", type number}, {"failing_rows", Int64.Type}, {"source_value", type number}, {"mart_value", type number}, {"variance", type number}})
