		summarizeBy: none
		sourceColumn: active_customers

		annotation SummarizationSetBy = User

	partition 'UCI Cohort' = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Data = Source{[Schema = PgSchemaUciMarts, Item = "uci_mart_customer_cohorts"]}[Data],
					Selected = Table.SelectColumns(Data, {"cohort_month", "months_since_first_purchase", "active_month", "cohort_customers", "active_customers"}),
					Typed = Table.TransformColumnTypes(Selected, {{"cohort_month", type date}, {"active_month", type date}})
				in
					Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
