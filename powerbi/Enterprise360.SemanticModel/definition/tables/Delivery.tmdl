	column order_id
		dataType: string
		isHidden
		lineageTag: 2a2457ae-aae9-5c17-9cf6-bbdaa9c6b1fb
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = User

	column delivered_date_key
		dataType: int64
		isHidden
		lineageTag: 5b12bcae-9631-500d-9c37-f41b588e8096
		summarizeBy: none
		sourceColumn: delivered_date_key

