	partition Delivery = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Data = Source{[Schema = PgSchema, Item = "fct_deliveries"]}[Data],
					Selected = Table.SelectColumns(Data, {"order_id", "delivered_date_key", "delivered_customer_at", "estimated_delivery_at", "delivered_carrier_at", "is_on_time", "is_otd_eligible", "delivery_days", "dq_missing_delivery_ts", "dq_delivered_before_purchase"})
