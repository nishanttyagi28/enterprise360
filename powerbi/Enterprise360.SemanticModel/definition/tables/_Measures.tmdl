/// Home table for all explicit Olist measures (BRL). Names follow docs/kpi-catalog.md; descriptions carry KPI ids.
table _Measures
	lineageTag: bc9655a5-5075-520c-85af-3f61c5256843

	/// KPI_GMV (SUPPORTED): Gross Merchandise Value: SUM(item_price), freight excluded. Not recognized revenue.
	measure GMV = SUM ( 'Order Item'[item_price] )
		formatString: R$ #,0
		displayFolder: Sales
		lineageTag: fc07342d-9d49-54d0-83a1-b9552c6f64bb

		annotation KPI_Id = KPI_GMV

		annotation KPI_Status = SUPPORTED

	/// KPI_GMV_INCL_FREIGHT (SUPPORTED): GMV plus customer-paid freight.
	measure 'GMV incl Freight' = [GMV] + [Freight Value]
		formatString: R$ #,0
		displayFolder: Sales
		lineageTag: 61fc7e58-4134-5b16-9a94-89de782d870d

		annotation KPI_Id = KPI_GMV_INCL_FREIGHT

		annotation KPI_Status = SUPPORTED

	/// KPI_NET_GMV (SUPPORTED): GMV of orders not canceled/unavailable.
	measure 'Net GMV' =
			CALCULATE (
				[GMV],
				KEEPFILTERS ( NOT 'Order'[order_status] IN { "canceled", "unavailable" } )
			)
		formatString: R$ #,0
		displayFolder: Sales
		lineageTag: cc39f73a-8a13-5586-b760-a07a4e8ae912

		annotation KPI_Id = KPI_NET_GMV

		annotation KPI_Status = SUPPORTED

	/// KPI_NET_GMV (SUPPORTED): Supporting measure (breakdown) under KPI_NET_GMV: GMV of canceled or unavailable orders (not returns) = [GMV] - [Net GMV]. About 0.715% of GMV overall; shown as a trend on a secondary axis, not a KPI.
	measure 'GMV Excluded from Net' = [GMV] - [Net GMV]
		formatString: R$ #,0
		displayFolder: Sales
		lineageTag: e3d61a83-0420-54f2-b826-0aa59420620e

		annotation KPI_Id = KPI_NET_GMV

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_NET_GMV

	/// KPI_FREIGHT (SUPPORTED): Freight charged to customers (customer freight, not logistics cost).
	measure 'Freight Value' = SUM ( 'Order Item'[freight_value] )
		formatString: R$ #,0
		displayFolder: Sales
		lineageTag: fb8d8c49-d7f3-514f-b988-97f8ff45a9d5

		annotation KPI_Id = KPI_FREIGHT

		annotation KPI_Status = SUPPORTED

	/// KPI_FREIGHT_SHARE (SUPPORTED): Freight Value / GMV (ratio of sums).
	measure 'Freight Share %' = DIVIDE ( [Freight Value], [GMV] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 8beada0b-1207-5a77-bea9-86025b01a6ea

		annotation KPI_Id = KPI_FREIGHT_SHARE

		annotation KPI_Status = SUPPORTED

	/// KPI_GMV_GROWTH (PARTIAL): Month-over-month GMV growth on calendar months by purchase date (evaluate at Year Month). BLANK when prior GMV is 0/blank or when the current or prior month is not complete (dim_date.is_complete_month = false). Also BLANK when the current or prior month is not a reporting month (dim_date.is_reporting_month = false; KPI_GMV_GROWTH v1.2.0 requires is_complete_month AND is_reporting_month for both months). PARTIAL: first/last coverage months are partial and sparse.
	measure 'GMV Growth %' =
			VAR _current = [GMV]
			VAR _previous = CALCULATE ( [GMV], DATEADD ( 'Date'[Date], -1, MONTH ) )
			VAR _currentIncomplete = CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[is_complete_month] = FALSE () ) ) > 0
			VAR _previousIncomplete = CALCULATE ( COUNTROWS ( 'Date' ), DATEADD ( 'Date'[Date], -1, MONTH ), KEEPFILTERS ( 'Date'[is_complete_month] = FALSE () ) ) > 0
			VAR _currentNotReporting = CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[is_reporting_month] = FALSE () ) ) > 0
			VAR _previousNotReporting = CALCULATE ( COUNTROWS ( 'Date' ), DATEADD ( 'Date'[Date], -1, MONTH ), KEEPFILTERS ( 'Date'[is_reporting_month] = FALSE () ) ) > 0
			RETURN
				IF ( ISBLANK ( _current ) || ISBLANK ( _previous ) || _previous = 0 || _currentIncomplete || _previousIncomplete || _currentNotReporting || _previousNotReporting, BLANK (), DIVIDE ( _current - _previous, _previous ) )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: be617cf4-cda9-5e09-bab1-937a55126a0f

		annotation KPI_Id = KPI_GMV_GROWTH

		annotation KPI_Status = PARTIAL

	/// KPI_PAYMENT_VALUE (SUPPORTED): Sum of recorded payments. Transaction value, not sales, not cash flow; does not reconcile to items+freight for some orders.
	measure 'Payment Value' = SUM ( 'Payment'[payment_value] )
		formatString: R$ #,0
		displayFolder: Payments
		lineageTag: 3dbf0507-17b7-5dd7-904e-7286875232b1

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Supporting measure: share of Payment Value by payment type. Payment mix, never sales.
	measure 'Payment Mix %' =
			DIVIDE (
				[Payment Value],
				CALCULATE ( [Payment Value], REMOVEFILTERS ( 'Payment'[Payment Type] ) )
			)
		formatString: 0.0%
		displayFolder: Payments
		lineageTag: 6cb3af03-f56b-50fd-b91c-72d12047e27d

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_ORDERS (SUPPORTED): Distinct orders (fct_orders unique on order_id). Under Product/Seller filters counts orders containing those lines.
	measure Orders =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						COUNTROWS ( 'Order' ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					COUNTROWS ( 'Order' )
				)
		formatString: #,0
		displayFolder: Orders
		lineageTag: 60f52318-f7ea-5c86-98ad-e19e251076cc

		annotation KPI_Id = KPI_ORDERS

		annotation KPI_Status = SUPPORTED

	/// KPI_ITEMS_PER_ORDER (SUPPORTED): Supporting measure: order lines (= units; Olist has one unit per line). Numerator of Items per Order.
	measure 'Items Sold' = COUNTROWS ( 'Order Item' )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 671393fa-f86c-5e45-82be-988c5ce2d634

		annotation KPI_Id = KPI_ITEMS_PER_ORDER

		annotation KPI_Status = SUPPORTED

	/// KPI_AOV (SUPPORTED): GMV / distinct orders with items (ratio of sums).
	measure AOV =
			VAR _ordersWithItems = DISTINCTCOUNT ( 'Order Item'[order_id] )
			RETURN
				DIVIDE ( [GMV], _ordersWithItems )
		formatString: R$ #,0.00
		displayFolder: Orders
		lineageTag: 0a3270d0-705d-5575-94b3-a9a2d2b492ce

		annotation KPI_Id = KPI_AOV

		annotation KPI_Status = SUPPORTED

	/// KPI_ITEMS_PER_ORDER (SUPPORTED): Order lines / distinct orders with items.
	measure 'Items per Order' = DIVIDE ( [Items Sold], DISTINCTCOUNT ( 'Order Item'[order_id] ) )
		formatString: #,0.00
		displayFolder: Orders
		lineageTag: 99cc6093-381a-5eaa-92cb-edebb29fc745

		annotation KPI_Id = KPI_ITEMS_PER_ORDER

		annotation KPI_Status = SUPPORTED

	/// KPI_CANCEL_RATE (SUPPORTED): Orders canceled or unavailable / Orders.
	measure 'Cancellation Rate %' =
			VAR _canceled =
				CALCULATE ( [Orders], KEEPFILTERS ( 'Order'[order_status] IN { "canceled", "unavailable" } ) )
			RETURN
				DIVIDE ( _canceled, [Orders] )
		formatString: 0.0%
		displayFolder: Orders
		lineageTag: 4b5fbe71-cb71-56e9-be18-0ac94f425ecf

		annotation KPI_Id = KPI_CANCEL_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_APPROVAL_HOURS (SUPPORTED): Average hours purchase -> approval (negative values excluded).
	measure 'Avg Approval Hours' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						CALCULATE ( AVERAGE ( 'Order'[hours_to_approve] ), KEEPFILTERS ( 'Order'[hours_to_approve] >= 0 ) ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					CALCULATE ( AVERAGE ( 'Order'[hours_to_approve] ), KEEPFILTERS ( 'Order'[hours_to_approve] >= 0 ) )
				)
		formatString: #,0.0
		displayFolder: Orders
		lineageTag: 46713fb0-509c-5115-b901-5474dde3f68a

		annotation KPI_Id = KPI_APPROVAL_HOURS

		annotation KPI_Status = SUPPORTED

	/// KPI_ACTIVE_CUSTOMERS (SUPPORTED): Distinct customer_unique_id (via customer_sk) with >=1 order in context.
	measure 'Active Customers' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						DISTINCTCOUNT ( 'Order'[customer_sk] ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					DISTINCTCOUNT ( 'Order'[customer_sk] )
				)
		formatString: #,0
		displayFolder: Customers
		lineageTag: a0e2f448-ed0c-5ed0-8000-b961c8a10049

		annotation KPI_Id = KPI_ACTIVE_CUSTOMERS

		annotation KPI_Status = SUPPORTED

	/// KPI_NEW_CUSTOMERS (SUPPORTED): Active customers whose first order date falls in the selected period (by month = first-order cohort size).
	measure 'New Customers' =
			VAR _start = MIN ( 'Date'[Date] )
			VAR _end = MAX ( 'Date'[Date] )
			RETURN
				CALCULATE (
					COUNTROWS ( 'Customer' ),
					'Order',
					KEEPFILTERS ( 'Customer'[First Order Date] >= _start && 'Customer'[First Order Date] <= _end )
				)
		formatString: #,0
		displayFolder: Customers
		lineageTag: 698f59d0-bf56-56fa-8daa-2e61d0a3ec04

		annotation KPI_Id = KPI_NEW_CUSTOMERS

		annotation KPI_Status = SUPPORTED

	/// KPI_REPEAT_RATE (SUPPORTED): Customers (customer_unique_id) with 2+ distinct orders within the selected period / active customers in the period.
	measure 'Repeat Purchase Rate %' =
			VAR _customers = VALUES ( 'Order'[customer_sk] )
			VAR _repeat = COUNTROWS ( FILTER ( _customers, CALCULATE ( COUNTROWS ( 'Order' ) ) >= 2 ) )
			RETURN
				DIVIDE ( _repeat, COUNTROWS ( _customers ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 5ebd39a0-eb98-5030-aaaa-dcf0e6fa375f

		annotation KPI_Id = KPI_REPEAT_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_CUSTOMER_RETENTION (PARTIAL): Customers active in the previous calendar month who order again in the current month / previous-month active. Evaluate at Year Month. PARTIAL: unstable on Olist's low repeat volume; show with [Retention Cohort Size].
	measure 'Customer Retention %' =
			VAR _current = VALUES ( 'Order'[customer_sk] )
			VAR _prior = CALCULATETABLE ( VALUES ( 'Order'[customer_sk] ), DATEADD ( 'Date'[Date], -1, MONTH ) )
			RETURN
				DIVIDE ( COUNTROWS ( INTERSECT ( _current, _prior ) ), COUNTROWS ( _prior ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 92b0a601-df29-53c2-bb39-605b4a99bbc7

		annotation KPI_Id = KPI_CUSTOMER_RETENTION

		annotation KPI_Status = PARTIAL

	/// KPI_CUSTOMER_RETENTION (PARTIAL): Supporting measure: denominator of Customer Retention % (previous-month active customers).
	measure 'Retention Cohort Size' = CALCULATE ( [Active Customers], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: df845ff8-b4d7-5d94-bfe7-30d9458421a7

		annotation KPI_Id = KPI_CUSTOMER_RETENTION

		annotation KPI_Status = PARTIAL

	/// KPI_OTD_RATE (SUPPORTED): Eligible orders (is_otd_eligible: delivered, delivered_customer_at present and >= purchased_at) delivered on/before the estimated date (date comparison) / eligible orders. Estimate is Olist's, not a contractual SLA. Dated by purchase date.
	measure 'On-Time Delivery %' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						DIVIDE (
							CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ), KEEPFILTERS ( 'Delivery'[is_on_time] = TRUE () ) ),
							CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ) )
						),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					DIVIDE (
						CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ), KEEPFILTERS ( 'Delivery'[is_on_time] = TRUE () ) ),
						CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ) )
					)
				)
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 380a190c-68b7-5d7e-a378-5753d6689967

		annotation KPI_Id = KPI_OTD_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_OTD_RATE (SUPPORTED): Supporting measure: same KPI on the delivery-date role. The Date selection is moved from the purchase date (Date->Order) to Delivery[delivered_date_key] via TREATAS; Customer, Geography, Status and RLS still reach Delivery through Order.
	measure 'On-Time Delivery % (by Delivery Date)' =
			CALCULATE (
				[On-Time Delivery %],
				REMOVEFILTERS ( 'Date' ),
				TREATAS ( VALUES ( 'Date'[date_key] ), 'Delivery'[delivered_date_key] )
			)
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 797d9739-5383-5824-9aec-de34d8bf62f0

		annotation KPI_Id = KPI_OTD_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_OTD_RATE (SUPPORTED): Supporting measure: eligible orders delivered after the estimated date (complement of the OTD numerator).
	measure 'Late Orders' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ), KEEPFILTERS ( 'Delivery'[is_on_time] = FALSE () ) ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ), KEEPFILTERS ( 'Delivery'[is_on_time] = FALSE () ) )
				)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: a736b08a-d877-5046-8646-3ed790fbac12

		annotation KPI_Id = KPI_OTD_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_SELLER_HANDOVER_OTD (PARTIAL): Order items handed to the carrier (fct_deliveries.delivered_carrier_at) at or before the item's shipping_limit_at (full timestamp comparison, computed in dbt as fct_order_items.is_handover_on_time) / items with both timestamps. shipping_limit_at is Olist's seller shipping deadline, not a contractual SLA. PARTIAL: carrier handover is recorded per order, so sellers in multi-seller orders share one handover time.
	measure 'Seller Handover On-Time %' =
			DIVIDE (
				CALCULATE ( COUNTROWS ( 'Order Item' ), KEEPFILTERS ( 'Order Item'[is_handover_on_time] = TRUE () ) ),
				CALCULATE ( COUNTROWS ( 'Order Item' ), KEEPFILTERS ( NOT ISBLANK ( 'Order Item'[is_handover_on_time] ) ) )
			)
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: d294ebbe-99e2-567f-8cc9-cdfda4808fdd

		annotation KPI_Id = KPI_SELLER_HANDOVER_OTD

		annotation KPI_Status = PARTIAL

	/// KPI_SELLER_HANDOVER_OTD (PARTIAL): Data-quality exclusion count, not an operational KPI: order items missing delivered_carrier_at or shipping_limit_at (is_handover_on_time is NULL), excluded from Seller Handover On-Time %.
	measure 'Handover Missing Timestamp' = CALCULATE ( COUNTROWS ( 'Order Item' ), KEEPFILTERS ( ISBLANK ( 'Order Item'[is_handover_on_time] ) ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 6828122c-e700-5a87-abb0-d78d9a3aecee

		annotation KPI_Id = KPI_SELLER_HANDOVER_OTD

		annotation KPI_Status = PARTIAL

	/// KPI_DELIVERY_DAYS (SUPPORTED): Average days purchase -> customer delivery over is_otd_eligible orders only (same filter as OTD).
	measure 'Avg Delivery Days' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						CALCULATE ( AVERAGE ( 'Delivery'[delivery_days] ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ) ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					CALCULATE ( AVERAGE ( 'Delivery'[delivery_days] ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ) )
				)
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: f3f8724c-f0f3-514b-8ce5-a4ab1adc63d4

		annotation KPI_Id = KPI_DELIVERY_DAYS

		annotation KPI_Status = SUPPORTED

	/// KPI_REVIEW_SCORE (SUPPORTED): Mean latest review score per order (fct_orders.latest_review_score), 1-5. CSAT proxy, not surveyed CSAT.
	measure 'Avg Review Score' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						AVERAGE ( 'Order'[Review Score] ),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					AVERAGE ( 'Order'[Review Score] )
				)
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: 33e1a691-dc73-5c1b-a9a0-8b89ee852cae

		annotation KPI_Id = KPI_REVIEW_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_LOW_REVIEW_RATE (SUPPORTED): Orders with latest score <= 2 / orders reviewed.
	measure 'Low Review %' =
			VAR _lineFiltered = ISCROSSFILTERED ( 'Product' ) || ISCROSSFILTERED ( 'Seller' )
			RETURN
				IF (
					_lineFiltered,
					CALCULATE (
						DIVIDE (
							CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( NOT ISBLANK ( 'Order'[Review Score] ) && 'Order'[Review Score] <= 2 ) ),
							CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( NOT ISBLANK ( 'Order'[Review Score] ) ) )
						),
						CROSSFILTER ( 'Order Item'[order_id], 'Order'[Order ID], BOTH )
					),
					DIVIDE (
						CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( NOT ISBLANK ( 'Order'[Review Score] ) && 'Order'[Review Score] <= 2 ) ),
						CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( NOT ISBLANK ( 'Order'[Review Score] ) ) )
					)
				)
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: e772de4d-c6fb-5fc8-8122-72b0cd75c0c7

		annotation KPI_Id = KPI_LOW_REVIEW_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Strict weighted DQ score from core.dq_run_summary.dq_score (only pass earns weight; warn and fail earn 0). Latest run (is_latest_run = TRUE) unless a run is selected; if several runs are selected, the latest of them.
	measure 'DQ Score %' =
			VAR _runSelected = ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Run Summary'[Run At] ),
					CALCULATE ( MAX ( 'DQ Run Summary'[Run At] ), REMOVEFILTERS ( 'DQ Run Summary' ), 'DQ Run Summary'[is_latest_run] = TRUE () )
				)
			RETURN
				CALCULATE ( MAX ( 'DQ Run Summary'[dq_score] ), REMOVEFILTERS ( 'DQ Run Summary' ), 'DQ Run Summary'[Run At] = _runAt )
		formatString: 0.0%
		displayFolder: Data Quality
		lineageTag: 86b4891f-5ae2-5be4-94d3-be0d8a2956bc

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_RECON_VARIANCE (SUPPORTED): Sum of (mart_value - source_value) over checks with a source_value; slice by KPI ID. Latest run unless a run is selected.
	measure 'Reconciliation Variance' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					SUMX (
						FILTER ( 'DQ Results', NOT ISBLANK ( 'DQ Results'[source_value] ) ),
						'DQ Results'[mart_value] - 'DQ Results'[source_value]
					),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		formatString: #,0.00
		displayFolder: Data Quality
		lineageTag: 0b4c617a-4d4e-51fe-aace-ddbe85a96e52

		annotation KPI_Id = KPI_RECON_VARIANCE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Supporting measure: checks with status fail in the latest (or selected) run.
	measure 'Checks Failed' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					CALCULATE ( COUNTROWS ( 'DQ Results' ), KEEPFILTERS ( 'DQ Results'[Status] = "fail" ) ),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 12f7df43-1fc8-548e-a88f-48297951becf

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Supporting measure: checks with status warn in the latest (or selected) run.
	measure 'Checks Warned' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					CALCULATE ( COUNTROWS ( 'DQ Results' ), KEEPFILTERS ( 'DQ Results'[Status] = "warn" ) ),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 9ad53076-5a00-5cdc-850f-e8f293d777a3

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Supporting measure: failed checks with severity block in the latest (or selected) run.
	measure 'Blocking Failures' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					CALCULATE (
						COUNTROWS ( 'DQ Results' ),
						KEEPFILTERS ( 'DQ Results'[Status] = "fail" ),
						KEEPFILTERS ( 'DQ Results'[Severity] = "block" )
					),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 77b9b54c-2550-5c95-b64f-d5be5bf96db3

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Supporting measure: sum of failing_rows in the latest (or selected) run.
	measure 'Failing Rows' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					SUM ( 'DQ Results'[failing_rows] ),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 031dca63-276f-5ce0-9cf5-019c15cdb39d

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_DQ_SCORE (SUPPORTED): Formatting helper only (not a KPI): hex status colour for conditional formatting of the checks table. Hidden.
	measure 'DQ Status Colour' =
			VAR _runSelected = ISFILTERED ( 'DQ Results'[Run ID] ) || ISFILTERED ( 'DQ Results'[Run At] ) || ISFILTERED ( 'DQ Run Summary'[Run ID] ) || ISFILTERED ( 'DQ Run Summary'[Run At] )
			VAR _runAt =
				IF (
					_runSelected,
					MAX ( 'DQ Results'[Run At] ),
					CALCULATE ( MAX ( 'DQ Results'[Run At] ), REMOVEFILTERS ( 'DQ Results' ) )
				)
			RETURN
				CALCULATE (
					SWITCH (
						SELECTEDVALUE ( 'DQ Results'[Status] ),
						"pass", "#D1FAE5",
						"warn", "#FEF3C7",
						"fail", "#FEE2E2",
						"#F3F4F6"
					),
					REMOVEFILTERS ( 'DQ Run Summary' ),
					REMOVEFILTERS ( 'DQ Results'[Run ID] ),
					'DQ Results'[Run At] = _runAt
				)
		isHidden
		displayFolder: Data Quality
		lineageTag: faf02164-0e08-53fe-aab3-0a859086f7ca

		annotation KPI_Id = KPI_DQ_SCORE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Data-quality exclusion count (validation rule of KPI_PAYMENT_VALUE), not sales: orders where |sum(payment_value) - sum(item_price + freight_value)| > 0.01 BRL. fct_orders.payment_vs_items_diff = coalesce(payments,0) - coalesce(items+freight,0), so orders missing either side count. Baseline: 1,076 orders.
	measure 'Payment Mismatch Orders' = CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( ABS ( 'Order'[payment_vs_items_diff] ) > 0.01 ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f508fa37-1f68-5b70-b2a9-220ceb766a6f

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Data-quality exclusion count (KPI_PAYMENT_VALUE exception breakdown): mismatched orders with payments but no order items.
	measure 'Payment Without Items Orders' = CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( ABS ( 'Order'[payment_vs_items_diff] ) > 0.01 ), KEEPFILTERS ( 'Order'[has_items] = FALSE () ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: a522143f-ee30-5b32-85e0-c35f0fdb1c08

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Data-quality exclusion count (KPI_PAYMENT_VALUE exception breakdown): mismatched orders with items but no payment record.
	measure 'Items Without Payment Orders' = CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( ABS ( 'Order'[payment_vs_items_diff] ) > 0.01 ), KEEPFILTERS ( 'Order'[has_items] = TRUE () ), KEEPFILTERS ( 'Order'[has_payment] = FALSE () ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 68a44f75-12c6-579e-96b7-563308a7e27e

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Data-quality exclusion count (KPI_PAYMENT_VALUE exception breakdown): both sides present, payments exceed items+freight by > 0.01 BRL (e.g. installment interest).
	measure 'Overpaid Orders' = CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( ABS ( 'Order'[payment_vs_items_diff] ) > 0.01 ), KEEPFILTERS ( 'Order'[has_items] = TRUE () ), KEEPFILTERS ( 'Order'[has_payment] = TRUE () ), KEEPFILTERS ( 'Order'[payment_vs_items_diff] > 0 ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: b1cc2cb5-e601-50e2-8506-dab1ae81f9d3

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Data-quality exclusion count (KPI_PAYMENT_VALUE exception breakdown): both sides present, payments below items+freight by > 0.01 BRL (e.g. vouchers/discounts).
	measure 'Underpaid Orders' = CALCULATE ( COUNTROWS ( 'Order' ), KEEPFILTERS ( ABS ( 'Order'[payment_vs_items_diff] ) > 0.01 ), KEEPFILTERS ( 'Order'[has_items] = TRUE () ), KEEPFILTERS ( 'Order'[has_payment] = TRUE () ), KEEPFILTERS ( 'Order'[payment_vs_items_diff] < 0 ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 8b02f63d-784d-5b86-9632-ef5aeda35108

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_OTD_RATE (SUPPORTED): Data-quality exclusion count, not an operational KPI: delivered orders without delivered_customer_at, excluded from OTD and delivery-days KPIs (fct_deliveries.dq_missing_delivery_ts).
	measure 'Delivered Missing Timestamp' = CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[dq_missing_delivery_ts] = TRUE () ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: aea166f5-9dc3-532a-915c-bc6c4805405b

		annotation KPI_Id = KPI_OTD_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_DELIVERY_DAYS (SUPPORTED): Data-quality exclusion count, not an operational KPI: delivery timestamp before purchase, excluded from OTD and delivery-days KPIs (fct_deliveries.dq_delivered_before_purchase).
	measure 'Delivered Before Purchase' = CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[dq_delivered_before_purchase] = TRUE () ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 5d6cb5dc-2be6-5e7e-b944-218570402eda

		annotation KPI_Id = KPI_DELIVERY_DAYS

		annotation KPI_Status = SUPPORTED

	/// KPI_OTD_RATE (SUPPORTED): Supporting measure: OTD denominator (is_otd_eligible = true).
	measure 'OTD Eligible Orders' = CALCULATE ( COUNTROWS ( 'Delivery' ), KEEPFILTERS ( 'Delivery'[is_otd_eligible] = TRUE () ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 1a7098d3-823f-5fdf-b4e5-e7f3475e4b5b

		annotation KPI_Id = KPI_OTD_RATE

		annotation KPI_Status = SUPPORTED

	/// KPI_PAYMENT_VALUE (SUPPORTED): Supporting DQ measure: row count of fct_payments in context.
	measure 'Payment Records' = COUNTROWS ( 'Payment' )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 597b06e7-d840-5dc4-8496-8e345444a870

		annotation KPI_Id = KPI_PAYMENT_VALUE

		annotation KPI_Status = SUPPORTED

	/// KPI_FUNNEL_MQLS (SUPPORTED): Distinct marketing qualified leads dated by first_contact_date (8,000 overall). June 2017 is a partial month (data starts 2017-06-14).
	measure MQLs = DISTINCTCOUNT ( 'Lead'[MQL ID] )
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: e752e26d-0717-5460-9e0e-e7c9b6e1cc90

		annotation KPI_Id = KPI_FUNNEL_MQLS

		annotation KPI_Status = SUPPORTED

	/// KPI_FUNNEL_MQLS (SUPPORTED): Supporting measure (breakdown): MQLs by Lead Origin. 'not_recorded' (null origin, 60) and 'unknown' (1,099) are separate items.
	measure 'MQLs by Origin' = [MQLs]
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: f5092ff7-11f9-5786-9063-83d1170d3507

		annotation KPI_Id = KPI_FUNNEL_MQLS

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_FUNNEL_MQLS

	/// KPI_FUNNEL_CLOSED_DEALS (SUPPORTED): Distinct closed deals dated by won_date (842 overall). Different time axis from MQLs: deals-in-month / MQLs-in-month is NOT a conversion rate.
	measure 'Closed Deals' = DISTINCTCOUNT ( 'Closed Deal'[MQL ID] )
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: 8343d22a-f367-56a8-88cd-689127bf7f72

		annotation KPI_Id = KPI_FUNNEL_CLOSED_DEALS

		annotation KPI_Status = SUPPORTED

	/// KPI_FUNNEL_CLOSED_DEALS (SUPPORTED): Supporting measure (breakdown): closed deals by business_segment (33 segments; 1 null).
	measure 'Closed Deals by Business Segment' = [Closed Deals]
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: a72571cb-e81e-509b-abb7-1f2c374eb487

		annotation KPI_Id = KPI_FUNNEL_CLOSED_DEALS

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_FUNNEL_CLOSED_DEALS

	/// KPI_FUNNEL_CLOSED_DEALS (SUPPORTED): Supporting measure (breakdown): closed deals by lead_type (6 null).
	measure 'Closed Deals by Lead Type' = [Closed Deals]
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: b463d925-6dc7-5715-bfd7-7a66dca86a16

		annotation KPI_Id = KPI_FUNNEL_CLOSED_DEALS

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_FUNNEL_CLOSED_DEALS

	/// KPI_FUNNEL_CLOSED_DEALS (SUPPORTED): Supporting measure (dq_exclusion): closed deals whose mql_id is not in fct_leads (0 at 2026-10-31).
	measure 'Unmatched Closed Deals' =
			COUNTROWS (
				EXCEPT (
					VALUES ( 'Closed Deal'[MQL ID] ),
					CALCULATETABLE ( VALUES ( 'Lead'[MQL ID] ), REMOVEFILTERS ( 'Lead' ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Lead Origin' ) )
				)
			) + 0
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: 9307630e-7179-5761-a69e-afccaaadabb6

		annotation KPI_Id = KPI_FUNNEL_CLOSED_DEALS

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = dq_exclusion

		annotation KPI_ParentKpi = KPI_FUNNEL_CLOSED_DEALS

	/// KPI_FUNNEL_CONVERSION_RATE (PARTIAL): Supporting measure (breakdown): MQLs in the first-contact cohort that became a closed deal at any later date (attributed to first-contact month, not won month).
	measure 'Converted Leads in Cohort' = CALCULATE ( DISTINCTCOUNT ( 'Lead'[MQL ID] ), KEEPFILTERS ( 'Lead'[is_closed] = TRUE () ) )
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: 4f726e1d-4a99-55dc-9b50-54209c9940d5

		annotation KPI_Id = KPI_FUNNEL_CONVERSION_RATE

		annotation KPI_Status = PARTIAL

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_FUNNEL_CONVERSION_RATE

	/// KPI_FUNNEL_CONVERSION_RATE (PARTIAL): Cohort conversion: converted leads in cohort / MQLs in cohort, by first-contact month (ratio of sums; 10.53% overall). Never deals-in-month / MQLs-in-month, never an average of monthly rates. PARTIAL: wins recorded only from 2017-12-05 (2017 cohorts under-observed); Apr-May 2018 cohorts immature (210-day window).
	measure 'Lead-to-Deal Conversion %' = DIVIDE ( [Converted Leads in Cohort], [MQLs] )
		formatString: 0.00%
		displayFolder: Marketing Funnel
		lineageTag: 1e9f9c6e-978c-5dc4-b1d8-10efbc84b0fc

		annotation KPI_Id = KPI_FUNNEL_CONVERSION_RATE

		annotation KPI_Status = PARTIAL

	/// KPI_FUNNEL_CONVERSION_RATE (PARTIAL): Supporting measure (formatting): 1 = cohort mature (cohort month end + 210 days <= latest won_date), 0 = immature (Apr and May 2018). Across several months it reflects the latest cohort in the selection.
	measure 'Cohort Is Mature' =
			VAR _maxWon = CALCULATE ( MAX ( 'Closed Deal'[Won Date] ), REMOVEFILTERS ( 'Closed Deal' ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Lead Origin' ) )
			VAR _lastCohortDay = EOMONTH ( MAX ( 'Lead'[First Contact Date] ), 0 )
			RETURN
				IF ( ISBLANK ( _lastCohortDay ), BLANK (), IF ( _lastCohortDay + 210 <= _maxWon, 1, 0 ) )
		formatString: 0
		displayFolder: Marketing Funnel
		lineageTag: 16ab0e21-346d-528e-bdc3-9a7212ff2504

		annotation KPI_Id = KPI_FUNNEL_CONVERSION_RATE

		annotation KPI_Status = PARTIAL

		annotation KPI_SupportingKind = formatting

		annotation KPI_ParentKpi = KPI_FUNNEL_CONVERSION_RATE

	/// KPI_FUNNEL_CONVERSION_RATE (PARTIAL): Hidden formatting helper for [Cohort Is Mature]: caveat amber #B45309 for immature cohorts, accent #0E7490 for mature.
	measure 'Cohort Maturity Colour' = IF ( [Cohort Is Mature] = 0, "#B45309", "#0E7490" )
		isHidden
		displayFolder: Marketing Funnel
		lineageTag: b3e8a923-a5cc-5435-8655-3f6b9b46100e

		annotation KPI_Id = KPI_FUNNEL_CONVERSION_RATE

		annotation KPI_Status = PARTIAL

		annotation KPI_SupportingKind = formatting

		annotation KPI_ParentKpi = KPI_FUNNEL_CONVERSION_RATE

	/// KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE (SUPPORTED): Median days from first contact to won date over matched deal rows with non-negative duration (14 over 841 deals). Recomputed from rows at every level; never an average of the mart's median_days_to_close.
	measure 'Median Days to Close' =
			MEDIANX (
				FILTER ( 'Closed Deal', NOT ISBLANK ( 'Closed Deal'[days_to_close] ) && 'Closed Deal'[days_to_close] >= 0 ),
				'Closed Deal'[days_to_close]
			)
		formatString: 0
		displayFolder: Marketing Funnel
		lineageTag: 69d56018-1d9e-515a-8127-26bfc1b51cd5

		annotation KPI_Id = KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE

		annotation KPI_Status = SUPPORTED

	/// KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE (SUPPORTED): Supporting measure (dq_exclusion): deals with won_date before first_contact_date (1), excluded from Median Days to Close.
	measure 'Negative Duration Deals' = CALCULATE ( COUNTROWS ( 'Closed Deal' ), KEEPFILTERS ( 'Closed Deal'[days_to_close] < 0 ) ) + 0
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: 9741859c-37f1-51f4-827c-2f4f1264e050

		annotation KPI_Id = KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = dq_exclusion

		annotation KPI_ParentKpi = KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE

	/// KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE (SUPPORTED): Supporting measure (breakdown) under KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE (approved by KPI & Quality): closed deals per days-to-close bucket from marts.mart_funnel_time_to_close. All dates (the mart has no date grain; date slicers do not apply). Negative-duration anomaly bucket excluded in M, so buckets total 841 valid deals.
	measure 'Closed Deals by Days-to-Close Bucket' = SUM ( 'Funnel Time to Close'[deals] )
		formatString: #,0
		displayFolder: Marketing Funnel
		lineageTag: 5a61a617-1b77-5cc2-82c0-b3a49bb81782

		annotation KPI_Id = KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE

		annotation KPI_Status = SUPPORTED

		annotation KPI_SupportingKind = breakdown

		annotation KPI_ParentKpi = KPI_FUNNEL_MEDIAN_DAYS_TO_CLOSE

