{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Enterprise360Dark",
  "dataColors": [
    "#22D3EE",
    "#3B82F6",
    "#818CF8",
    "#2DD4BF",
    "#60A5FA",
    "#A78BFA",
    "#94A3B8",
    "#F59E0B"
  ],
  "foreground": "#E5E7EB",
  "foregroundNeutralSecondary": "#94A3B8",
  "foregroundNeutralTertiary": "#64748B",
  "background": "#0B1220",
  "secondaryBackground": "#111A2E",
  "backgroundLight": "#1F2A44",
  "backgroundNeutral": "#1F2A44",
  "tableAccent": "#22D3EE",
  "accent": "#22D3EE",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#22D3EE",
  "center": "#3B82F6",
  "minimum": "#1E3A8A",
  "null": "#64748B",
  "hyperlink": "#22D3EE",
  "visitedHyperlink": "#60A5FA",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#22D3EE"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E5E7EB"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E5E7EB"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "fontSize": 11
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "foreground": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1F2A44"
              }
            }
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#111A2E"
              }
            }
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ]
      }
    }
  }
}
